# Django (local development)
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings.develop

# Database (production — Render sets automatically)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis (production, optional — speeds up sessions/cache)
# REDIS_URL=redis://127.0.0.1:6379/0

# Custom domain (production only, comma-separated)
# EXTRA_ALLOWED_HOSTS=lmm.in.ua,www.lmm.in.ua
# EXTRA_CSRF_ORIGINS=https://lmm.in.ua,https://www.lmm.in.ua

# Cloudinary (production — for admin uploads; product CSV images use external URLs)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email (production, optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=shop@lmm.in.ua

# MonoBank Acquiring — required for online payments
# Prod: https://web.monobank.ua | Test: https://api.monobank.ua
MONOBANK_TOKEN=

# Nova Poshta — required for city/warehouse autocomplete on checkout
# API key: https://my.novaposhta.ua → Налаштування → Безпека → API ключі
NOVA_POSHTA_API_KEY=
